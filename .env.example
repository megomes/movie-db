# Database (Neon Postgres) and sign-in (Neon Auth with Google)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Comma-separated e-mails allowed in
ALLOWED_EMAILS=

# Movies and series: TMDB (where to watch in Brazil comes from TMDB/JustWatch) and OMDb (IMDb, RT, Metacritic)
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
OMDB_API_KEY=
# Games: IGDB (Twitch app)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Books: Google Books and Hardcover
GOOGLE_BOOKS_API_KEY=
HARDCOVER_API_TOKEN=

# Optional
CRON_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=            # mailto:you@example.com
# Only for scripts/import-obsidian.ts
OBSIDIAN_BACKLOG_DIR=
OBSIDIAN_BACKLOG_OWNER=
# Optional: the shared family list (id kept in the data, and its title)
NEXT_PUBLIC_FAMILY_LIST_ID=
NEXT_PUBLIC_FAMILY_LIST_TITLE=
